# =====================================================================
# DeviceRank AI Publisher Configuration
# =====================================================================

# 1. Google Gemini AI Settings
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 2. Google Blogger API Settings
# Found in your Blogger Dashboard URL (e.g., https://www.blogger.com/blog/posts/YOUR_BLOG_ID)
BLOGGER_BLOG_ID=your_blogger_blog_id_here

# Required by GitHub Actions (local OAuth can use the files below instead)
BLOGGER_CLIENT_ID=your_oauth_client_id
BLOGGER_CLIENT_SECRET=your_oauth_client_secret
BLOGGER_REFRESH_TOKEN=your_oauth_refresh_token

# Blogger OAuth2 Credentials path (downloaded from Google Cloud Console)
BLOGGER_CLIENT_SECRET_FILE=client_secret.json
BLOGGER_TOKEN_FILE=token.json

# 3. Publishing Preferences
# Options: DRAFT or LIVE (Default: DRAFT for safety)
DEFAULT_PUBLISH_STATUS=DRAFT

# Minimum body length enforced for evergreen tutorials
EVERGREEN_MIN_WORD_COUNT=1200

# Whole-article rewrites allowed when a generated tutorial fails quality gates (1-4)
EVERGREEN_QUALITY_ATTEMPTS=3

# Safety lock: scheduled and normal publishing should remain evergreen-only.
# Leave false unless you intentionally need the old RSS/news publishing commands.
ALLOW_LEGACY_NEWS_PUBLISHING=false

# Legacy RSS settings (ignored by the evergreen workflow)
MAX_POSTS_PER_RUN=1
TARGET_WORD_COUNT=1000
DIGEST_STORY_COUNT=8
DIGEST_TARGET_WORD_COUNT=1400

# 4. Image Settings (required for evergreen publishing)
# Get a free Access Key at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
EVERGREEN_IMAGE_COUNT=3

# 5. Weekly Reddit Topic-Signal Publisher (separate workflow)
# These are external Reddit Data API OAuth credentials. A Devvit initialization
# code is not a client ID or client secret and cannot authenticate GitHub Actions.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:devicerank-weekly:1.0 (by /u/your_reddit_username)
REDDIT_SUBREDDITS=your_subreddit

# Keep false until Reddit has approved this use and you have confirmed any
# commercial/content rights required for the intended blog publishing workflow.
REDDIT_USE_RIGHTS_CONFIRMED=false

# The fetcher reads only titles and aggregate engagement. It never requests or
# persists post bodies, comments, usernames, or profile data.
REDDIT_POST_LIMIT=25
REDDIT_MAX_TOPIC_CHECKS=4
REDDIT_MIN_WORD_COUNT=1000
REDDIT_IMAGE_COUNT=2
REDDIT_USE_SEARCH_GROUNDING=true
